# Database
NEON_DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/freightpipe?sslmode=require

# Object storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=freightpipe-docs

# LLM provider key pools (comma-separated for multiple keys)
OPENROUTER_API_KEYS=
GEMINI_API_KEYS=
GROQ_API_KEYS=

# App secrets
WEBHOOK_HMAC_SECRET=
BYOK_ENCRYPTION_KEY=
WORKER_TO_PROCESSOR_SHARED_SECRET=

# Config
MAX_UPLOAD_SIZE_MB=25
LLM_DAILY_BUDGET_SOFT_CEILING_PCT=90
JOB_RETRY_MAX_ATTEMPTS=3
WEBHOOK_RETRY_SCHEDULE_MINUTES=1,5,30,180,1440
